    "pretest": "npm run fixtures:generate",
    "dev": "vite --config vite.config.ts --host 127.0.0.1",
    "build": "tsc -b && vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts --host 127.0.0.1",
    "dev:network": "vite --config vite.config.ts --host 0.0.0.0",
    "preview:network": "vite preview --config vite.config.ts --host 0.0.0.0",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "build:mock": "npm run fixtures:generate && tsc -b && vite build --config vite.config.ts --mode mock",
    "test:production-build": "node tests/check-production-build.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/syne": "^5.3.0",
