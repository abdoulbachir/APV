    "react-dom": "18.3.1",
    "react-router-dom": "7.18.7"
  },
  "devDependencies": {
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.9.3",
    "vite": "6.4.6"
  },
  "engines": {
    "node": ">=22"
  }
