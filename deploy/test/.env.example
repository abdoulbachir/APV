# Settings of the private test site. Copy to deploy/test/.env, which git ignores, and fill in.
# Nothing here is a real credential. Never commit the copy.

# The name or address testers type, without "https://". It must be what they really use.
APV_SITE_HOST=apv.home.example
# The same, as the browser sees it. Add ":port" only if APV_HTTPS_PORT below is not 443.
APV_PUBLIC_ORIGIN=https://apv.home.example

# "internal": a certificate from this server's own private authority; testers install its root
# certificate once (README). For a public name reachable on ports 80 and 443, put your email
# address here instead and a public certificate is obtained automatically.
APV_TLS=internal
APV_HTTP_PORT=80
APV_HTTPS_PORT=443

# Any long random text:  openssl rand -hex 24
APV_DATABASE_PASSWORD=

# Each:  openssl rand -base64 32   Losing APV_MFA_ENCRYPTION_KEY locks out every enrolled staff account.
APV_MFA_ENCRYPTION_KEY=
APV_HASH_KEY=

# The breached-password list (docs/backend-password-blocklist.md): the folder on this machine that
# holds the .bin file and its .manifest, and the name of the .bin file.
APV_BLOCKLIST_DIR=/srv/apv/blocklist
APV_BLOCKLIST_FILE=breached-sha1.bin
# Recommended: the SHA-256 printed when the list was built.
APV_PASSWORD_BLOCKLIST_SHA256=
