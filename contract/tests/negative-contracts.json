[
  {"name": "sign-in 429 using the shared, cacheable response", "expect": "every identity response must declare Cache-Control: no-store", "patch": [{"op": "replace", "path": "/paths/~1auth~1login/post/responses/429", "value": {"$ref": "#/components/responses/RateLimited"}}]},
  {"name": "account 500 using the shared response", "expect": "every identity response must declare Cache-Control: no-store", "patch": [{"op": "replace", "path": "/paths/~1me/get/responses/500", "value": {"$ref": "#/components/responses/InternalError"}}]},
  {"name": "sign-up 400 using the shared response", "expect": "every identity response must declare Cache-Control: no-store", "patch": [{"op": "replace", "path": "/paths/~1auth~1register/post/responses/400", "value": {"$ref": "#/components/responses/ValidationError"}}]},
  {"name": "identity 405 using the shared response", "expect": "every identity response must declare Cache-Control: no-store", "patch": [{"op": "replace", "path": "/paths/~1auth~1logout/post/responses/405", "value": {"$ref": "#/components/responses/MethodNotAllowed"}}]},
  {"name": "identity 503 using the shared response", "expect": "every identity response must declare Cache-Control: no-store", "patch": [{"op": "replace", "path": "/paths/~1auth~1csrf/get/responses/503", "value": {"$ref": "#/components/responses/Unavailable"}}]},
  {"name": "401 response losing its no-store header", "expect": "every identity response must declare Cache-Control: no-store", "patch": [{"op": "remove", "path": "/components/responses/Unauthenticated/headers"}]},
  {"name": "413 response losing its no-store header", "expect": "every identity response must declare Cache-Control: no-store", "patch": [{"op": "remove", "path": "/components/responses/PayloadTooLarge/headers"}]},
  {"name": "public totals answered with a no-store identity response", "expect": "public read responses are not no-store", "patch": [{"op": "replace", "path": "/paths/~1stats/get/responses/429", "value": {"$ref": "#/components/responses/IdentityRateLimited"}}]},
  {"name": "405 without Allow", "expect": "must declare the Allow header", "patch": [{"op": "remove", "path": "/components/responses/MethodNotAllowed/headers"}]},
  {"name": "identity 405 without Allow", "expect": "must declare the Allow header", "patch": [{"op": "remove", "path": "/components/responses/IdentityMethodNotAllowed/headers/Allow"}]},
  {"name": "429 without Retry-After", "expect": "429: must declare Retry-After", "patch": [{"op": "remove", "path": "/components/responses/IdentityRateLimited/headers/Retry-After"}]},
  {"name": "identity 503 without Retry-After", "expect": "503: must declare Retry-After", "patch": [{"op": "remove", "path": "/components/responses/IdentityUnavailable/headers/Retry-After"}]},
  {"name": "public operation losing its 405", "expect": "must document 405", "patch": [{"op": "remove", "path": "/paths/~1cases/get/responses/405"}]},
  {"name": "email on a public donor", "expect": "looks private", "patch": [{"op": "add", "path": "/components/schemas/PublicDonor/properties/email", "value": {"type": "string"}}]},
  {"name": "role on a public update", "expect": "looks private", "patch": [{"op": "add", "path": "/components/schemas/CaseUpdate/properties/authorRole", "value": {"type": "string"}}]},
  {"name": "public case referring to the account", "expect": "must not contain Account", "patch": [{"op": "add", "path": "/components/schemas/CaseDetail/properties/owner", "value": {"$ref": "#/components/schemas/Account"}}]},
  {"name": "shared error envelope referring to the account", "expect": "must not contain Account", "patch": [{"op": "add", "path": "/components/schemas/Error/properties/account", "value": {"$ref": "#/components/schemas/Account"}}]},
  {"name": "draft among the public statuses", "expect": "must not contain draft", "patch": [{"op": "add", "path": "/components/schemas/PublicCaseStatus/enum/-", "value": "draft"}]},
  {"name": "sign-up accepting a role", "expect": "RegisterRequest must not accept \"role\"", "patch": [{"op": "add", "path": "/components/schemas/RegisterRequest/properties/role", "value": {"$ref": "#/components/schemas/Role"}}]},
  {"name": "sign-up accepting a verified flag", "expect": "RegisterRequest must not accept \"emailVerified\"", "patch": [{"op": "add", "path": "/components/schemas/RegisterRequest/properties/emailVerified", "value": {"type": "boolean"}}]},
  {"name": "sign-out without the CSRF header", "expect": "requires the CSRF header", "patch": [{"op": "remove", "path": "/paths/~1auth~1logout/post/parameters"}]},
  {"name": "sign-in without the CSRF header", "expect": "requires the CSRF header", "patch": [{"op": "remove", "path": "/paths/~1auth~1login/post/parameters"}]},
  {"name": "CSRF header renamed in one place only", "expect": "CsrfToken.headerName", "patch": [{"op": "replace", "path": "/components/parameters/CsrfHeader/name", "value": "X-XSRF-TOKEN"}]},
  {"name": "password echoed in a sign-in answer", "expect": "must not contain LoginRequest", "patch": [{"op": "add", "path": "/components/schemas/SignedIn/properties/sent", "value": {"$ref": "#/components/schemas/LoginRequest"}}]},
  {"name": "password hash in the account view", "expect": "must never be returned", "patch": [{"op": "add", "path": "/components/schemas/Account/properties/passwordHash", "value": {"type": "string"}}]},
  {"name": "failed-attempt counter in the account view", "expect": "must never be returned", "patch": [{"op": "add", "path": "/components/schemas/Account/properties/failedAttempts", "value": {"type": "integer"}}]},
  {"name": "recovery codes returned by the account endpoint", "expect": "not an approved credential operation", "patch": [{"op": "replace", "path": "/paths/~1me/get/responses/200/content/application~1json/schema", "value": {"$ref": "#/components/schemas/MfaRecoveryCodes"}}]},
  {"name": "authenticator secret returned by sign-in", "expect": "not an approved credential operation", "patch": [{"op": "add", "path": "/components/schemas/SignedIn/properties/enrollment", "value": {"$ref": "#/components/schemas/MfaEnrollment"}}]},
  {"name": "open account object", "expect": "additionalProperties: false", "patch": [{"op": "replace", "path": "/components/schemas/Account/additionalProperties", "value": true}]},
  {"name": "schema without an audience", "expect": "x-audience must be one of", "patch": [{"op": "remove", "path": "/components/schemas/AuthOptions/x-audience"}]},
  {"name": "operation without its session states", "expect": "x-session-state must list", "patch": [{"op": "remove", "path": "/paths/~1auth~1login/post/x-session-state"}]},
  {"name": "operation with an unknown session state", "expect": "x-session-state must list", "patch": [{"op": "replace", "path": "/paths/~1auth~1mfa~1verify/post/x-session-state", "value": ["half_signed_in"]}]},
  {"name": "account endpoint open to anonymous", "expect": "sessionCookie requirement", "patch": [{"op": "replace", "path": "/paths/~1me/get/x-session-state", "value": ["anonymous", "authenticated"]}]},
  {"name": "password change without a session requirement", "expect": "sessionCookie requirement", "patch": [{"op": "remove", "path": "/paths/~1auth~1change-password/post/security"}]},
  {"name": "sign-in that does not say what a signed-in session gets", "expect": "must document 409", "patch": [{"op": "remove", "path": "/paths/~1auth~1login/post/responses/409"}]},
  {"name": "pending sign-in allowed to carry an account", "expect": "LoginResult must be oneOf", "patch": [{"op": "add", "path": "/components/schemas/SecondFactorPending/properties/account", "value": {"$ref": "#/components/schemas/Account"}}]},
  {"name": "signed-in result allowed without an account", "expect": "LoginResult must be oneOf", "patch": [{"op": "replace", "path": "/components/schemas/SignedIn/required", "value": ["status"]}]},
  {"name": "second-factor success allowed to stay pending", "expect": "verifyMfa success must be", "patch": [{"op": "replace", "path": "/paths/~1auth~1mfa~1verify/post/responses/200/content/application~1json/schema", "value": {"$ref": "#/components/schemas/LoginResult"}}]},
  {"name": "public operation depending on the session", "expect": "does not depend on the session", "patch": [{"op": "add", "path": "/paths/~1cases/get/x-session-state", "value": ["authenticated"]}]},
  {"name": "picture address that is not a media path", "expect": "must use MediaPath", "patch": [{"op": "replace", "path": "/components/schemas/PublicDonor/properties/avatarUrl", "value": {"type": "string"}}]},
  {"name": "optional request body", "expect": "a defined request body is required", "patch": [{"op": "replace", "path": "/paths/~1auth~1login/post/requestBody/required", "value": false}]}
]
