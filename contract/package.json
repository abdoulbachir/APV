{
  "name": "apv-gakasinay-contract",
  "version": "0.4.0",
  "description": "Validation of the APV-GAKASINAY API contract and shared fixtures. Not part of the frontend build.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "redocly lint openapi.yaml",
    "check:openapi": "node tools/check-openapi.mjs",
    "check:fixtures": "node tools/check-fixtures.mjs",
    "project": "node tools/project-public.mjs",
    "validate": "npm run lint && npm run check:openapi && npm run check:fixtures && npm run check:dataset && npm run check:frontend-parity && npm run check:types",
    "check:dataset": "npm run generate:dataset && node tools/check-dataset.mjs",
    "check:frontend-parity": "npm run generate:dataset && node --experimental-strip-types tools/check-frontend-parity.mjs",
    "generate:types": "node tools/generate-public-types.mjs",
    "check:types": "node tools/generate-public-types.mjs --check",
    "generate:dataset": "node tools/generate-dataset.mjs"
  },
  "devDependencies": {
    "@redocly/cli": "2.83.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "yaml": "2.9.1"
  }
}
