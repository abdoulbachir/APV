# Local development settings. Copy to .env, which is ignored by git. No real credentials here.
# The same variables are read by compose.yaml and by the backend.

APV_DATABASE_PASSWORD=change-me-local-only
APV_DATABASE_PORT=5432
APV_DATABASE_URL=jdbc:postgresql://localhost:5432/apv
APV_DATABASE_USER=apv

# Backend port. The Vite development proxy forwards /api and /media to it.
APV_PORT=8080

# Only read in the "dev" profile. DESTRUCTIVE: at every start the dev profile deletes everything
# in the database above and loads this fictional dataset. The folder is where its pictures are
# served from. Use ../contract/fixtures/example.json for the small dataset.
APV_FIXTURES_PATH=../contract/fixtures/dataset.json
APV_FIXTURES_MEDIA_ROOT=../contract/fixtures
