# Local development settings. Copy to .env, which is ignored by git. No real credentials here.
# The same variables are read by compose.yaml and by the backend.

APV_DATABASE_PASSWORD=change-me-local-only
APV_DATABASE_PORT=5432
APV_DATABASE_URL=jdbc:postgresql://localhost:5432/apv
APV_DATABASE_USER=apv

# Backend port. The Vite development proxy forwards /api and /media to it.
APV_PORT=8080

# Only read in the "dev" profile. DESTRUCTIVE: at every start the dev profile deletes everything
# in the database above and loads this fictional dataset. The folder is where its pictures are
# served from. Use ../contract/fixtures/example.json for the small dataset.
APV_FIXTURES_PATH=../contract/fixtures/dataset.json
APV_FIXTURES_MEDIA_ROOT=../contract/fixtures

# Identity (milestone 1B). In the "dev" profile all of these are optional: keys are generated at
# each start, the cookie is "apv_session" without Secure, and public sign-up is open.
# Outside dev/test the two keys are REQUIRED (openssl rand -base64 32), never committed:
# APV_MFA_ENCRYPTION_KEY=
# APV_HASH_KEY=
# Outside dev/test also REQUIRED: the comprehensive local breached-password list, built as
# docs/backend-password-blocklist.md describes. Never committed.
# APV_PASSWORD_BLOCKLIST_PATH=
# The exact origins accepted on POST. Leave unset in development: the origin then has to equal
# the host the request was addressed to, which is the case through the Vite proxy and directly.
# Set it in production behind a TLS-terminating proxy, for example https://your.site
# APV_ALLOWED_ORIGINS=
